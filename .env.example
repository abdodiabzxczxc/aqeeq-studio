# ==============================================================================
# استوديو العقيق (Al-Aqeeq Studio) - ملف متغيرات البيئة التجريبية (.env.example)
# ==============================================================================

# بيئة التشغيل (production للإنتاج / development للتطوير المحلي)
NODE_ENV=production

# المنفذ الذي يستمع إليه الخادم (على Render أو الاستضافة يحدده النظام تلقائياً)
PORT=3000

# رابط الاتصال بقاعدة بيانات MySQL (إلزامي للبيانات الدائمة)
# مثال: TiDB Cloud / Aiven / PlanetScale / Local MySQL
DATABASE_URL=mysql://root:password@127.0.0.1:3306/aqeeq_studio

# المفتاح السري لتشفير جلسات JWT وحمايتها (32 محرف على الأقل)
JWT_SECRET=aqeeq_studio_super_secret_jwt_key_2026_secure

# بيانات المدير الافتراضي الأول (يتم إنشاؤه تلقائياً عند بدء التشغيل إن لم يكن موجوداً)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aqeeq2026
ADMIN_NAME=مدير استوديو العقيق
ADMIN_EMAIL=admin@alaqeeq.edu.sa
